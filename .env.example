# Root environment file for local development
NODE_ENV=development
PORT=4000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_BOT_USERNAME=@NEXBOOST_bot
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
TELEGRAM_ALLOWED_CHAT_IDS=795356140

# Mini App / Web App
MINIAPP_URL=http://localhost:5173
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:5174
MINIAPP_BASE_URL=http://localhost:5173

# DoH upstream (trusted resolver)
DOH_UPSTREAM_URL=https://dns.google/dns-query
DOH_HOSTNAME=dns.nexbooster.local

# Admin auth
JWT_SECRET=replace-with-a-very-long-random-string
ADMIN_SESSION_SECRET=replace-with-another-long-raSndom-string

# Payments
DEFAULT_ETB_CURRENCY=ETB

# Frontend ports
MINIAPP_PORT=http://warm-crisp-b41d36.netlify.app
ADMIN_PORT=5174

# Database / app
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:5174
MINIAPP_BASE_URL=http://localhost:5173
